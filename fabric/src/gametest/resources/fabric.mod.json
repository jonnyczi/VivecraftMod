{
  "schemaVersion": 1,
  "id": "vivecraft-gametest",
  "version": "1.0.0",
  "name": "Vivecraft Gametests",
  "description": "Automated client tests for Vivecraft, run with ./gradlew :fabric:runClientGameTest",
  "license": "LGPLv3",
  "environment": "client",
  "entrypoints": {
    "fabric-client-gametest": [
      "org.vivecraft.gametest.PassthroughClientGameTest",
      "org.vivecraft.gametest.TabletopClientGameTest",
      "org.vivecraft.gametest.TabletopInteractionClientGameTest",
      "org.vivecraft.gametest.TabletopPersistenceClientGameTest",
      "org.vivecraft.gametest.TabletopNavigationClientGameTest",
      "org.vivecraft.gametest.TabletopSituationsClientGameTest",
      "org.vivecraft.gametest.IrisClientGameTest"
    ]
  },
  "depends": {
    "vivecraft": "*"
  }
}
